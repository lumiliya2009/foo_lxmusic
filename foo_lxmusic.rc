#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_LX_SEARCH DIALOGEX 0, 0, 310, 146
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LX 在线音乐搜索"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "关键词：",IDC_STATIC,10,13,42,10
    COMBOBOX        IDC_LX_KEYWORD,55,10,245,170,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "音源：",IDC_STATIC,10,39,42,10
    COMBOBOX        IDC_LX_SOURCE,55,36,245,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "站点：",IDC_STATIC,10,65,42,10
    COMBOBOX        IDC_LX_SITE,55,62,105,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "类型：",IDC_STATIC,170,65,36,10
    COMBOBOX        IDC_LX_TYPE,207,62,93,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "结果中按回车或双击：打开集合，播放歌曲。",IDC_LX_STATUS,10,88,290,22
    DEFPUSHBUTTON   "搜索",IDOK,190,121,50,16
    PUSHBUTTON      "取消",IDCANCEL,250,121,50,16
END

IDD_LX_BROWSE DIALOGEX 0, 0, 310, 116
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LX 在线音乐 - 随便看看"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "音源：",IDC_STATIC,10,18,42,10
    COMBOBOX        IDC_LX_SOURCE,55,15,245,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "站点：",IDC_STATIC,10,47,42,10
    COMBOBOX        IDC_LX_SITE,55,44,245,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "确认后把当前站点的榜单或推荐内容放进播放列表。",IDC_LX_STATUS,10,72,290,20
    DEFPUSHBUTTON   "查看",IDOK,190,94,50,16
    PUSHBUTTON      "取消",IDCANCEL,250,94,50,16
END

IDD_LX_UPDATE DIALOGEX 0, 0, 500, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LX 在线音乐更新"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "发现新版本：",IDC_STATIC,12,14,66,10
    LTEXT           "",IDC_LX_UPDATE_VERSION,82,14,120,10
    LTEXT           "更新内容：",IDC_STATIC,12,36,66,10
    EDITTEXT        IDC_LX_UPDATE_NOTES,12,51,476,235,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "下载并安装",IDOK,326,292,82,17
    PUSHBUTTON      "稍后",IDCANCEL,418,292,70,17
END

IDD_LX_PAGE DIALOGEX 0, 0, 260, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "搜索结果页数跳转"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_LX_STATUS,10,10,240,12
    LTEXT           "跳转到第几页：",IDC_STATIC,10,34,85,12
    EDITTEXT        IDC_LX_PAGE_NUMBER,100,30,150,15,ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "跳转",IDOK,140,62,50,16
    PUSHBUTTON      "取消",IDCANCEL,200,62,50,16
END

IDD_LX_SOURCES DIALOGEX 0, 0, 620, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "管理 LX 音源"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "已保存的音源：",IDC_STATIC,10,10,190,10
    LISTBOX         IDC_LX_SOURCE_LIST,10,25,190,218,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "音源详情：",IDC_STATIC,215,10,395,10
    EDITTEXT        IDC_LX_SOURCE_DETAILS,215,25,395,218,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "右键音源可切换、编辑、更新、复制地址或删除。",IDC_STATIC,10,262,300,10
    PUSHBUTTON      "导入文件…",IDC_LX_IMPORT_FILE,368,258,68,18
    PUSHBUTTON      "网址导入…",IDC_LX_IMPORT_URL,441,258,70,18
    PUSHBUTTON      "关闭",IDCANCEL,563,258,45,18
END

IDD_LX_SOURCE_EDITOR DIALOGEX 0, 0, 620, 420
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "编辑 LX 音源"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "直接编辑音源脚本。修改 Cookies、授权信息后保存即可；校验失败会保留本次编辑内容。",IDC_STATIC,10,10,600,12
    EDITTEXT        IDC_LX_EDITOR_TEXT,10,27,600,368,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "保存",IDOK,490,400,55,16
    PUSHBUTTON      "取消",IDCANCEL,555,400,55,16
END

IDD_LX_DOWNLOAD_DONE DIALOGEX 0, 0, 470, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LX 批量下载"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_LX_DOWNLOAD_DONE_TEXT,10,10,450,185,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "打开下载文件夹",IDC_LX_OPEN_DOWNLOAD_DIR,10,205,100,17
    DEFPUSHBUTTON   "关闭",IDCANCEL,405,205,55,17
END

IDD_LX_URL DIALOGEX 0, 0, 330, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "从网址导入 LX 音源"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "音源脚本网址（HTTPS/HTTP）：",IDC_STATIC,10,10,175,10
    EDITTEXT        IDC_LX_URL,10,25,310,15,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "导入",IDOK,210,57,50,16
    PUSHBUTTON      "取消",IDCANCEL,270,57,50,16
END

IDD_LX_LYRICS DIALOGEX 0, 0, 430, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "在线歌词"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_LX_LYRICS,8,8,414,270,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "关闭（Esc）",IDCANCEL,350,286,72,16
END

IDD_LX_DOWNLOAD DIALOGEX 0, 0, 430, 388
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "下载在线歌曲 / 专辑"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "保存到：",IDC_LX_FOLDER_LABEL,10,14,42,10
    EDITTEXT        IDC_LX_FOLDER,55,10,295,15,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…",IDC_LX_BROWSE,358,10,62,16
    LTEXT           "音质：",IDC_LX_QUALITY_LABEL,10,44,42,10
    COMBOBOX        IDC_LX_DOWNLOAD_QUALITY,55,40,115,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "同时任务数：",IDC_LX_WORKERS_LABEL,195,44,80,10
    COMBOBOX        IDC_LX_DOWNLOAD_WORKERS,280,40,70,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "命名(&N)：",IDC_LX_NAMING_LABEL,10,66,42,10
    COMBOBOX        IDC_LX_DOWNLOAD_NAMING,55,62,365,150,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "字段：{序号} {曲名} {艺术家} {专辑名} {音质}\n扩展名自动添加；每张专辑从 01 开始编号。",IDC_LX_NAMING_HINT,55,84,365,24
    LTEXT           "示例：",IDC_LX_PREVIEW_LABEL,10,114,42,10
    EDITTEXT        IDC_LX_DOWNLOAD_PREVIEW,55,110,365,15,ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    CONTROL         "下载所有搜索结果页（从第 1 页开始）",IDC_LX_DOWNLOAD_ALL_PAGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,136,410,12
    CONTROL         "失败后自动跳过",IDC_LX_DOWNLOAD_SKIP_FAILURES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,156,160,12
    CONTROL         "完成后查重并删除重复文件",IDC_LX_DOWNLOAD_CLEANUP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,185,156,235,12
    LTEXT           "查重以文件内容为准，只清理本次下载的重复音频，原有文件保留。",IDC_LX_CLEANUP_HINT,10,175,410,18
    LTEXT           "",IDC_LX_DOWNLOAD_SUMMARY,10,175,410,18
    LTEXT           "下载项目（专辑含全部歌曲和封面）：",IDC_LX_DOWNLOAD_ITEMS_LABEL,10,201,265,10
    PUSHBUTTON      "全选",IDC_LX_SELECT_ALL,302,196,55,16
    PUSHBUTTON      "全不选",IDC_LX_SELECT_NONE,365,196,55,16
    CONTROL         "",IDC_LX_DOWNLOAD_ITEMS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,217,410,140
    DEFPUSHBUTTON   "开始下载",IDOK,295,366,62,16
    PUSHBUTTON      "取消",IDCANCEL,365,366,55,16
END

IDD_LX_PREFERENCES DIALOGEX 0, 0, 430, 278
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "LX 在线音乐"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    CONTROL         "自动检查组件更新（启动后检查，每天一次）",IDC_LX_AUTO_UPDATES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,10,410,12
    CONTROL         "下载前显示临时设置（关闭后使用精简下载窗口）",IDC_LX_DOWNLOAD_OVERRIDES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,30,410,12
    CONTROL         "搜索结果按下载命名模板显示",IDC_LX_APPLY_SEARCH_NAMING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,50,410,12
    LTEXT           "默认位置：",IDC_STATIC,10,80,58,10
    EDITTEXT        IDC_LX_FOLDER,70,76,280,15,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…",IDC_LX_BROWSE,358,76,62,16
    LTEXT           "默认音质：",IDC_STATIC,10,107,58,10
    COMBOBOX        IDC_LX_DOWNLOAD_QUALITY,70,103,100,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "同时任务数：",IDC_STATIC,195,107,80,10
    COMBOBOX        IDC_LX_DOWNLOAD_WORKERS,280,103,70,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "默认命名：",IDC_STATIC,10,134,58,10
    COMBOBOX        IDC_LX_DOWNLOAD_NAMING,70,130,350,140,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "字段：{序号} {曲名} {艺术家} {专辑名} {音质}\n扩展名自动添加；下载窗口中的临时调整不会覆盖默认值。",IDC_STATIC,70,153,350,24
    CONTROL         "下载失败后自动跳过，继续后面的歌曲或页面",IDC_LX_DOWNLOAD_SKIP_FAILURES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,186,410,12
    CONTROL         "下载完成后查重并删除重复文件",IDC_LX_DOWNLOAD_CLEANUP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,206,410,12
    LTEXT           "查重以文件内容为准，只删除本次下载的重复副本，原有文件保留。",IDC_STATIC,10,225,410,22
    PUSHBUTTON      "立即检查更新",IDC_LX_CHECK_NOW,10,253,92,16
END

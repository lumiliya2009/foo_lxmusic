#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_LX_SEARCH DIALOGEX 0, 0, 310, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LX 在线音乐搜索"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "关键词：",IDC_STATIC,10,13,42,10
    EDITTEXT        IDC_LX_KEYWORD,55,10,245,15,ES_AUTOHSCROLL
    LTEXT           "站点：",IDC_STATIC,10,39,42,10
    COMBOBOX        IDC_LX_SITE,55,36,105,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "类型：",IDC_STATIC,170,39,36,10
    COMBOBOX        IDC_LX_TYPE,207,36,93,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "结果中按回车或双击：打开专辑 / 歌手 / 歌单，播放歌曲。",IDC_LX_STATUS,10,62,290,22
    DEFPUSHBUTTON   "搜索",IDOK,190,95,50,16
    PUSHBUTTON      "取消",IDCANCEL,250,95,50,16
END

IDD_LX_URL DIALOGEX 0, 0, 330, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "从网址导入 LX 音源"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "音源脚本网址（HTTPS/HTTP）：",IDC_STATIC,10,10,175,10
    EDITTEXT        IDC_LX_URL,10,25,310,15,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "导入",IDOK,210,57,50,16
    PUSHBUTTON      "取消",IDCANCEL,270,57,50,16
END

IDD_LX_LYRICS DIALOGEX 0, 0, 430, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "在线歌词"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_LX_LYRICS,8,8,414,270,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "关闭（Esc）",IDCANCEL,350,286,72,16
END

IDD_LX_DOWNLOAD DIALOGEX 0, 0, 430, 255
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "下载在线歌曲 / 专辑"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "保存到：",IDC_STATIC,10,14,42,10
    EDITTEXT        IDC_LX_FOLDER,55,10,295,15,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览…",IDC_LX_BROWSE,358,10,62,16
    LTEXT           "音质：",IDC_STATIC,10,44,42,10
    COMBOBOX        IDC_LX_DOWNLOAD_QUALITY,55,40,115,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "下载项目（专辑含全部歌曲和封面）：",IDC_STATIC,10,66,265,10
    PUSHBUTTON      "全选",IDC_LX_SELECT_ALL,302,61,55,16
    PUSHBUTTON      "全不选",IDC_LX_SELECT_NONE,365,61,55,16
    CONTROL         "",IDC_LX_DOWNLOAD_ITEMS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,82,410,140
    DEFPUSHBUTTON   "开始下载",IDOK,295,231,62,16
    PUSHBUTTON      "取消",IDCANCEL,365,231,55,16
END
